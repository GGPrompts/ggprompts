{
  "category": "music-art",
  "description": "Sounds, paintings, colors, and creative data",
  "apis": [
    {
      "name": "MusicBrainz API",
      "url": "https://musicbrainz.org/doc/MusicBrainz_API",
      "base_endpoint": "https://musicbrainz.org/ws/2/",
      "auth": "none",
      "description": "Extensive music metadata database with 12 core entity types (artists, recordings, releases, etc.)",
      "sample_endpoint": "https://musicbrainz.org/ws/2/artist?query=artist:The%20Beatles&fmt=json",
      "response_format": "json",
      "cors": false,
      "status": "active"
    },
    {
      "name": "Cover Art Archive",
      "url": "https://coverartarchive.org/",
      "base_endpoint": "https://coverartarchive.org/",
      "auth": "none",
      "description": "Repository of music cover art from Internet Archive and MusicBrainz community",
      "sample_endpoint": "https://coverartarchive.org/release/12345678-1234-1234-1234-123456789012",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "TheAudioDB",
      "url": "https://www.theaudiodb.com/",
      "base_endpoint": "https://www.theaudiodb.com/api/v1/json/",
      "auth": "key-free-tier",
      "description": "Music database with artist details, albums, tracks, and high-quality artwork",
      "sample_endpoint": "https://www.theaudiodb.com/api/v1/json/artist.php?i=111278",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Deezer API",
      "url": "https://developers.deezer.com/",
      "base_endpoint": "https://api.deezer.com/",
      "auth": "none",
      "description": "Music catalog API with tracks, albums, artists, and playlists (no auth for basic searches)",
      "sample_endpoint": "https://api.deezer.com/search?q=artist:Daft%20Punk",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "The Metropolitan Museum of Art API",
      "url": "https://metmuseum.github.io/",
      "base_endpoint": "https://collectionapi.metmuseum.org/public/collection/v1/",
      "auth": "none",
      "description": "470,000+ artworks with high-resolution public domain images (CC0 license)",
      "sample_endpoint": "https://collectionapi.metmuseum.org/public/collection/v1/artworks?hasImages=true&isPublicDomain=true",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Art Institute of Chicago API",
      "url": "https://www.artic.edu/open-access/public-api",
      "base_endpoint": "https://api.artic.edu/api/v1/",
      "auth": "none",
      "description": "Collections, exhibitions, publications, and events from major art museum (50,000+ CC0 images)",
      "sample_endpoint": "https://api.artic.edu/api/v1/artworks?limit=10",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Cleveland Museum of Art API",
      "url": "https://www.clevelandart.org/open-access-api",
      "base_endpoint": "https://openaccess-api.clevelandart.org/api/",
      "auth": "none",
      "description": "64,000+ artworks with high-res images for 37,000+ works (CC0 license)",
      "sample_endpoint": "https://openaccess-api.clevelandart.org/api/artworks?limit=10",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Rijksmuseum API",
      "url": "https://data.rijksmuseum.nl/docs/search",
      "base_endpoint": "https://data.rijksmuseum.nl/object-metadata/api/",
      "auth": "key-free-tier",
      "description": "800,000+ objects including 763,000+ artworks with high-resolution images (CC0 license)",
      "sample_endpoint": "https://data.rijksmuseum.nl/object-metadata/api/search?query=painting&rows=10",
      "response_format": "json",
      "cors": false,
      "status": "active"
    },
    {
      "name": "The Color API",
      "url": "https://www.thecolorapi.com/",
      "base_endpoint": "https://www.thecolorapi.com/",
      "auth": "none",
      "description": "Color conversion and scheme generation (monochrome, complement, triad, quad, etc.)",
      "sample_endpoint": "https://www.thecolorapi.com/id?hex=FF5733",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Colormind API",
      "url": "http://colormind.io/api-access/",
      "base_endpoint": "http://colormind.io/api/",
      "auth": "none",
      "description": "AI-powered color palette generator (free for personal/non-commercial use)",
      "sample_endpoint": "http://colormind.io/api/",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "lyrics.ovh",
      "url": "https://lyricsovh.docs.apiary.io/",
      "base_endpoint": "https://api.lyrics.ovh/v1/",
      "auth": "none",
      "description": "Simple lyrics API for fetching song lyrics by artist and song name",
      "sample_endpoint": "https://api.lyrics.ovh/v1/The%20Beatles/Hey%20Jude",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Genius API",
      "url": "https://genius.com/api-clients",
      "base_endpoint": "https://api.genius.com/",
      "auth": "key-free-tier",
      "description": "Song metadata, lyrics, annotations, and artist information from Genius.com",
      "sample_endpoint": "https://api.genius.com/search?q=The%20Beatles&access_token=YOUR_TOKEN",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Last.fm API",
      "url": "https://www.last.fm/api",
      "base_endpoint": "https://ws.audioscrobbler.com/2.0/",
      "auth": "key-free-tier",
      "description": "Music metadata, scrobbling data, artist/album/track info, and social features",
      "sample_endpoint": "https://ws.audioscrobbler.com/2.0/?method=artist.getinfo&artist=Cher&api_key=YOUR_KEY&format=json",
      "response_format": "json",
      "cors": false,
      "status": "active"
    },
    {
      "name": "Creative Commons Catalog API (Openverse)",
      "url": "https://api.openverse.org/",
      "base_endpoint": "https://api.openverse.org/v1/",
      "auth": "none",
      "description": "330+ million openly-licensed images and artwork (CC-licensed and public domain)",
      "sample_endpoint": "https://api.openverse.org/v1/images?q=painting",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Museum of Modern Art (MoMA) API",
      "url": "https://api.moma.org/",
      "base_endpoint": "https://api.moma.org/",
      "auth": "none",
      "description": "Art, exhibition, and artist data from MoMA collection",
      "sample_endpoint": "https://api.moma.org/artworks",
      "response_format": "json",
      "cors": true,
      "status": "active"
    }
  ]
}
