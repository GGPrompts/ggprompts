{
  "category": "geography",
  "description": "Geocoding, geolocation, elevation data, and geographic information services",
  "apis": [
    {
      "name": "BigDataCloud",
      "url": "https://www.bigdatacloud.com/",
      "base_endpoint": "https://api.bigdatacloud.net/data",
      "auth": "none",
      "description": "Client-side reverse geocoding. Explicitly designed for browser use without API keys",
      "sample_endpoint": "https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=37.42&longitude=-122.08&localityLanguage=en",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "GeoJS",
      "url": "https://www.geojs.io/",
      "base_endpoint": "https://get.geojs.io/v1",
      "auth": "none",
      "description": "IP-based geolocation \u2014 country, city, coordinates, timezone",
      "sample_endpoint": "https://get.geojs.io/v1/ip/geo.json",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Country.is",
      "url": "https://country.is/",
      "base_endpoint": "https://api.country.is",
      "auth": "none",
      "description": "Simple IP-to-country geolocation. Minimal and fast",
      "sample_endpoint": "https://api.country.is/",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Open Topo Data",
      "url": "https://www.opentopodata.org/",
      "base_endpoint": "https://api.opentopodata.org/v1",
      "auth": "none",
      "description": "Elevation/topography data from multiple global datasets",
      "sample_endpoint": "https://api.opentopodata.org/v1/mapzen?locations=51.875,-3.4",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Nominatim",
      "url": "https://nominatim.org/",
      "base_endpoint": "https://nominatim.openstreetmap.org",
      "auth": "none",
      "description": "OpenStreetMap forward/reverse geocoding. 1 req/sec, requires User-Agent header",
      "sample_endpoint": "https://nominatim.openstreetmap.org/search?q=Tokyo&format=json",
      "response_format": "json",
      "cors": true,
      "status": "active"
    }
  ]
}