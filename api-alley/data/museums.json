{
  "category": "museums",
  "description": "Museum collections, library catalogs, and digital archives from world-class institutions",
  "apis": [
    {
      "name": "Metropolitan Museum of Art",
      "url": "https://metmuseum.github.io/",
      "base_endpoint": "https://collectionapi.metmuseum.org/public/collection/v1",
      "auth": "none",
      "description": "470,000+ artworks with images, departments, and search. CC0 images. 80 req/sec",
      "sample_endpoint": "https://collectionapi.metmuseum.org/public/collection/v1/objects/45734",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Art Institute of Chicago",
      "url": "https://api.artic.edu/docs/",
      "base_endpoint": "https://api.artic.edu/api/v1",
      "auth": "none",
      "description": "Hundreds of thousands of artworks with IIIF image URLs, artist data, and rich metadata",
      "sample_endpoint": "https://api.artic.edu/api/v1/artworks?limit=2",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Cleveland Museum of Art",
      "url": "https://openaccess-api.clevelandart.org/",
      "base_endpoint": "https://openaccess-api.clevelandart.org/api",
      "auth": "none",
      "description": "64,000+ artwork records with 37,000+ CC0-licensed images",
      "sample_endpoint": "https://openaccess-api.clevelandart.org/api/artworks/?limit=2",
      "response_format": "json",
      "cors": true,
      "status": "active"
    },
    {
      "name": "Open Library",
      "url": "https://openlibrary.org/developers/api",
      "base_endpoint": "https://openlibrary.org",
      "auth": "none",
      "description": "3M+ books from Internet Archive. Search by title, author, ISBN, subject",
      "sample_endpoint": "https://openlibrary.org/search.json?q=the+lord+of+the+rings&limit=3",
      "response_format": "json",
      "cors": true,
      "status": "active"
    }
  ]
}